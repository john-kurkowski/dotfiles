#!/bin/sh

if [ "${DOTFILES_TEST_ZSH_SCRIPT:-}" != "$0" ]; then
  dotfiles_test_runner_dir=$(/usr/bin/dirname "$0")
  exec env \
    DOTFILES_TEST_ZSH_SCRIPT="$0" \
    ZDOTDIR="$dotfiles_test_runner_dir/.zsh-no-startup" \
    /bin/zsh -f "$0" "$@"
fi

# Test this dotfiles repo without requiring project-local package manifests or a
# non-bare checkout in the real home directory.
#
# The bootstrap starts Zsh with an empty ZDOTDIR so the runner never evaluates
# host startup files. The shell tests source checkout startup files explicitly
# with isolated dependencies.
#
# Default mode runs in a disposable normal clone so package-manager state,
# Neovim plugin bootstrap, and other temporary files stay out of the author's
# actual `$HOME`. `--here` runs the same checks in the current checkout, which
# is useful for CI and for explicit local debugging.
#
# Coverage:
# - Markdown formatting with Prettier
# - Lua formatting and lint for the tracked Neovim config
# - Zsh syntax for the shell entrypoints
# - Zsh startup scope for non-interactive, interactive, and login shells
# - A headless Neovim startup smoke test with isolated XDG state
#
# The script installs the Node-backed Markdown formatter into a temporary
# directory on each run instead of relying on a tracked `package.json` or
# `node_modules`.

set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}
run_here=0
assume_yes=0
apply_fixes=0
keep_clone=${DOTFILES_CI_KEEP_CLONE:-0}

usage() {
  cat <<'EOF'
Usage:
  dotfiles-test [--here] [--fix] [--yes]

Without arguments, run the checks in a disposable normal clone.

Options:
  --here        Run in the current checkout instead of a temp clone.
  --fix         Apply fixes where supported before running the remaining checks.
  -y, --yes     Skip the confirmation prompt for --here.
  -h, --help    Show this help.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --here)
      run_here=1
      ;;
    --fix)
      apply_fixes=1
      ;;
    -y|--yes)
      assume_yes=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 "dotfiles-test: unknown argument: $1"
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -d "$repo_root/.dotfiles" ]]; then
  git_cmd=(git --git-dir="$repo_root/.dotfiles" --work-tree="$repo_root")
  clone_source=$repo_root/.dotfiles
elif git -C "$repo_root" rev-parse --show-toplevel >/dev/null 2>&1; then
  git_cmd=(git -C "$repo_root")
  clone_source=$repo_root
else
  print -u2 "dotfiles-test: could not find the dotfiles repository from $repo_root"
  exit 1
fi

cd "$repo_root"

require_cmd() {
  local cmd=$1
  local help=${2:-}

  if command -v "$cmd" >/dev/null 2>&1; then
    return 0
  fi

  print -u2 "dotfiles-test: missing required command: $cmd"
  if [[ -n "$help" ]]; then
    print -u2 "dotfiles-test: $help"
  fi
  exit 127
}

write_executable() {
  local executable_path=$1

  cat >"$executable_path"
  chmod +x "$executable_path"
}

assert_equal() {
  local actual=$1
  local expected=$2
  local label=$3

  if [[ "$actual" == "$expected" ]]; then
    return 0
  fi

  print -u2 "dotfiles-test: $label"
  print -u2 "dotfiles-test: expected: $expected"
  print -u2 "dotfiles-test: actual:   $actual"
  exit 1
}

test_zsh_startup_scope() {
  local tmp_root=$1
  local test_home="${tmp_root:A}/zsh-startup-home"

  mkdir -p \
    "$test_home/.local/bin" \
    "$test_home/.local/share/mise/shims" \
    "$test_home/brew/bin" \
    "$test_home/mise-env/bin" \
    "$tmp_root/zsh-startup-cwd"
  cp .zshenv .zprofile .zshrc "$test_home"/

  write_executable "$test_home/.local/bin/mise" <<'EOF'
#!/bin/sh
printf '%s\n' "mise $*" >>"$DOTFILES_TEST_MISE_LOG"

case "$1:$2:$3" in
  env:-s:zsh)
    printf '%s\n' 'export DOTFILES_TEST_MISE_ENV=loaded'
    printf '%s\n' 'export PATH="$HOME/mise-env/bin:$PATH"'
    if [ -n "${DOTFILES_TEST_MISE_ENV_CWD_LOG:-}" ]; then
      printf '%s\n' "$PWD" >>"$DOTFILES_TEST_MISE_ENV_CWD_LOG"
    fi
    ;;
  activate:zsh:--shims)
    printf '%s\n' 'export DOTFILES_TEST_MISE_SHIMS=loaded'
    printf '%s\n' 'export PATH="$HOME/.local/share/mise/shims:$PATH"'
    ;;
  activate:zsh:)
    printf '%s\n' 'export DOTFILES_TEST_MISE_ACTIVATE=loaded'
    ;;
esac
EOF
  ln -s "$test_home/.local/bin/mise" "$test_home/brew/bin/mise"

  write_executable "$test_home/.local/share/mise/shims/python" <<'EOF'
#!/bin/sh
printf '%s\n' 'Mise shim Python'
EOF

  write_executable "$test_home/mise-env/bin/python" <<'EOF'
#!/bin/sh
printf '%s\n' 'Mise env Python'
EOF

  write_executable "$test_home/.local/bin/brew" <<'EOF'
#!/bin/sh
if [ "$1" = shellenv ]; then
  printf '%s\n' 'export DOTFILES_TEST_BREW=loaded'
fi
EOF

  write_executable "$test_home/.local/bin/starship" <<'EOF'
#!/bin/sh
if [ "$1" = init ]; then
  printf '%s\n' 'export DOTFILES_TEST_ZSHRC=loaded'
fi
EOF

  write_executable "$test_home/.local/bin/zoxide" <<'EOF'
#!/bin/sh
if [ "$1" = init ]; then
  printf '%s\n' ''
fi
EOF

  write_executable "$test_home/.local/bin/sheldon" <<'EOF'
#!/bin/sh
exit 0
EOF

  local noninteractive_log="$tmp_root/mise-noninteractive.log"
  local noninteractive_env_cwd_log="$tmp_root/mise-noninteractive-env-cwd.log"
  local startup_cwd="${tmp_root:A}/zsh-startup-cwd"
  local noninteractive_output
  noninteractive_output=$(
    cd "$startup_cwd" &&
      env -i \
        DOTFILES_TEST_MISE_LOG="$noninteractive_log" \
        DOTFILES_TEST_MISE_ENV_CWD_LOG="$noninteractive_env_cwd_log" \
        HOME="$test_home" \
        PATH="/usr/bin:/bin" \
        ZDOTDIR="$test_home" \
        zsh -c 'print -- "${DOTFILES_TEST_MISE_ENV:-unset}:${DOTFILES_TEST_MISE_SHIMS:-unset}:${DOTFILES_TEST_MISE_ACTIVATE:-unset}:${DOTFILES_TEST_ZSHRC:-unset}"; python; print -- "$PWD"'
  )

  assert_equal "$noninteractive_output" $'loaded:loaded:unset:unset\nMise shim Python\n'"$startup_cwd" "non-interactive zsh should load Mise env and resolve commands through shims"
  assert_equal "$(<"$noninteractive_env_cwd_log")" "$test_home" "non-interactive zsh should evaluate Mise env from home without changing its current directory"
  assert_equal "$(<"$noninteractive_log")" $'mise env -s zsh\nmise activate zsh --shims' "non-interactive zsh should load Mise env before shims"

  local interactive_log="$tmp_root/mise-interactive.log"
  local interactive_output
  interactive_output=$(
    env -i \
      DOTFILES_TEST_MISE_LOG="$interactive_log" \
      HOME="$test_home" \
      PATH="/usr/bin:/bin" \
      TERM_PROGRAM=WarpTerminal \
      ZDOTDIR="$test_home" \
      zsh -ic 'print -- "${DOTFILES_TEST_MISE_ENV:-unset}:${DOTFILES_TEST_MISE_SHIMS:-unset}:${DOTFILES_TEST_MISE_ACTIVATE:-unset}:${DOTFILES_TEST_ZSHRC:-unset}"; python'
  )

  assert_equal "$interactive_output" $'loaded:loaded:loaded:loaded\nMise shim Python' "interactive zsh should retain Mise env and shims before .zshrc activation"
  assert_equal "$(<"$interactive_log")" $'mise env -s zsh\nmise activate zsh --shims\nmise activate zsh' "interactive zsh should add shell hooks after loading Mise env and shims"

  # A real login shell also reads the host's /etc/zprofile. Simulate its PATH
  # reset in an isolated shell, leaving a Homebrew-installed Mise available so
  # this verifies that .zprofile restores shims without host configuration.
  local login_log="$tmp_root/mise-login.log"
  local login_output
  login_output=$(
    env -i \
      DOTFILES_TEST_MISE_LOG="$login_log" \
      HOME="$test_home" \
      PATH="/usr/bin:/bin" \
      ZDOTDIR="$test_home" \
      zsh -dfc '
        source "$ZDOTDIR/.zshenv"
        PATH="$HOME/brew/bin:/usr/bin:/bin"
        export PATH
        source "$ZDOTDIR/.zprofile"
        print -- "${DOTFILES_TEST_MISE_ENV:-unset}:${DOTFILES_TEST_MISE_SHIMS:-unset}:${DOTFILES_TEST_MISE_ACTIVATE:-unset}:${DOTFILES_TEST_ZSHRC:-unset}"
        python
      '
  )

  assert_equal "$login_output" $'loaded:loaded:unset:unset\nMise shim Python' "login zsh should retain Mise env and restore shims without interactive activation"
  assert_equal "$(<"$login_log")" $'mise env -s zsh\nmise activate zsh --shims\nmise activate zsh --shims' "login zsh should restore shims after the system PATH reset"
}

run_checks_here() {
  local work_root=$1

  cd "$work_root"

  require_cmd git
  require_cmd node "Install Node 22 via mise, for example: mise use -g node@22"
  require_cmd npm "Install Node 22 via mise, for example: mise use -g node@22"
  require_cmd nvim "Install Neovim, for example: brew install neovim"
  require_cmd stylua "Install Stylua, for example: brew install stylua"
  require_cmd luacheck "Install Luacheck, for example: brew install luacheck"
  require_cmd zsh "Install zsh, for example: brew install zsh"

  local tmp_root
  tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-test.XXXXXX")
  local tool_cwd="$tmp_root/tool-cwd"
  mkdir -p "$tool_cwd"

  local tracked_md=()
  local markdown_path
  for markdown_path in "${(@0)$("${git_cmd[@]}" ls-files -z -- '*.md')}"; do
    if [[ -n "$markdown_path" && ! -L "$work_root/$markdown_path" ]]; then
      tracked_md+=("$work_root/$markdown_path")
    fi
  done

  if (( ${#tracked_md[@]} > 0 )); then
    (
      cd "$tool_cwd" &&
        npm install \
          --prefix "$tmp_root/npm-tools" \
          --no-package-lock \
          --no-save \
          prettier@3 >/dev/null
    )

    if (( apply_fixes == 1 )); then
      (
        cd "$tool_cwd" &&
          "$tmp_root/npm-tools/node_modules/.bin/prettier" --list-different --write -- "${tracked_md[@]}"
      )
    else
      (
        cd "$tool_cwd" &&
          "$tmp_root/npm-tools/node_modules/.bin/prettier" --check -- "${tracked_md[@]}"
      )
    fi
  fi

  if (( apply_fixes == 1 )); then
    (
      cd "$tool_cwd" &&
        stylua "$work_root/.vim/init.lua" "$work_root/.vim/lua"
    )
  else
    (
      cd "$tool_cwd" &&
        stylua --check --output-format Summary "$work_root/.vim/init.lua" "$work_root/.vim/lua"
    )
  fi
  (
    cd "$tool_cwd" &&
      luacheck --quiet --config "$work_root/.vim/.luacheckrc" "$work_root/.vim/init.lua" "$work_root/.vim/lua"
  )
  (
    cd "$tool_cwd" &&
      zsh -n "$work_root/.zshenv" "$work_root/.zprofile" "$work_root/.zshrc"
  )
  test_zsh_startup_scope "$tmp_root"

  mkdir -p \
    "$tmp_root/xdg-cache" \
    "$tmp_root/xdg-config" \
    "$tmp_root/xdg-data" \
    "$tmp_root/xdg-state"

  local nvim_log="$tmp_root/nvim.log"
  if ! (
    cd "$tool_cwd" &&
      env \
        HOME="$work_root" \
        XDG_CACHE_HOME="$tmp_root/xdg-cache" \
        XDG_CONFIG_HOME="$tmp_root/xdg-config" \
        XDG_DATA_HOME="$tmp_root/xdg-data" \
        XDG_STATE_HOME="$tmp_root/xdg-state" \
        nvim --headless "+Lazy! restore" "+qa"
  ) >"$nvim_log" 2>&1; then
    cat "$nvim_log"
    rm -rf "$tmp_root"
    exit 1
  fi

  rm -rf "$tmp_root"
}

run_checks_in_temp_clone() {
  require_cmd git
  require_cmd rsync "Install rsync, for example: brew install rsync"

  local tmp_root
  tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-test-clone.XXXXXX")

  cleanup_clone() {
    if [[ "$keep_clone" == "1" ]]; then
      print "dotfiles-test: kept temp clone at $tmp_root/repo"
      return 0
    fi

    rm -rf "$tmp_root"
  }

  git clone "$clone_source" "$tmp_root/repo" >/dev/null

  local overlay_files=("${(@0)$("${git_cmd[@]}" ls-files -z)}")
  overlay_files=("${(@)overlay_files:#}")
  overlay_files=("${(@)overlay_files:#(#m)(?)}")
  local extra_dir
  for extra_dir in .bin .github; do
    if [[ ! -d "$repo_root/$extra_dir" ]]; then
      continue
    fi

    local extra_files=("${(@0)$("${git_cmd[@]}" ls-files -z --others --exclude-standard -- "$extra_dir")}")
    overlay_files+=("${extra_files[@]}")
  done

  local existing_overlay_files=()
  local overlay_file
  for overlay_file in "${overlay_files[@]}"; do
    if [[ -e "$repo_root/$overlay_file" || -L "$repo_root/$overlay_file" ]]; then
      existing_overlay_files+=("$overlay_file")
    fi
  done

  if (( ${#existing_overlay_files[@]} > 0 )); then
    rsync -a --files-from=<(printf '%s\0' "${existing_overlay_files[@]}") --from0 "$repo_root"/ "$tmp_root/repo"/
  fi

  local deleted_files=("${(@0)$("${git_cmd[@]}" ls-files -z --deleted)}")
  if (( ${#deleted_files[@]} > 0 )); then
    (cd "$tmp_root/repo" && rm -f -- "${deleted_files[@]}")
  fi

  local nested_args=(--here --yes)
  if (( apply_fixes == 1 )); then
    nested_args+=(--fix)
  fi

  (cd "$tmp_root/repo" && ./.bin/dotfiles-test "${nested_args[@]}")
  cleanup_clone
}

confirm_here_run() {
  if (( assume_yes == 1 )); then
    return 0
  fi

  local prompt="dotfiles-test: run checks in the current checkout and allow temporary files under this checkout? [y/N] "
  local reply

  if [[ -t 0 ]]; then
    read -r "?$prompt" reply
  else
    print -u2 "$prompt"
    read -r reply || return 1
  fi

  [[ "$reply" == [Yy] || "$reply" == [Yy][Ee][Ss] ]]
}

if (( run_here == 1 )); then
  if ! confirm_here_run; then
    print -u2 "dotfiles-test: aborted"
    exit 1
  fi

  run_checks_here "$repo_root"
else
  run_checks_in_temp_clone
fi
